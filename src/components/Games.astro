---
import { PESADILLA, url } from '../lib/sitio';
import CodeWindow from './CodeWindow.astro';
import juego from '../ejemplos/juego.cometa?raw';

const modulos = ['', 'graficos', 'entrada', 'audio', 'recursos', 'tiempo', 'retro'];
---

<section id="juegos" class="seccion juegos">
	<div class="contenedor rejilla">
		<div>
			<span class="etiqueta">// pincel</span>
			<h2>Aprende <span class="resaltado">jugando.</span></h2>
			<p class="texto">
				Pincel es la biblioteca de juegos 2D de Cometa. Implementa <code>actualizar</code> y <code>pintar</code>,
				llama a <code>pincel.ejecutar</code> y ya tienes una ventana con tu juego. Sin configuración, sin
				archivos extra.
			</p>
			<ul class="modulos" aria-label="Módulos de Pincel">
				{modulos.map((m) => <li>std/pincel{m && '/' + m}</li>)}
			</ul>
			<p class="texto">
				¿Sin dibujos? El módulo <code>retro</code> incluye fuentes pixeladas e íconos de fantasía listos para usar.
				Activa <code>pixelado = verdadero</code> para un estilo nítido de 8 bits.
			</p>
		</div>

		<div class="demo">
			<figure class="video">
			<video
				class="pantalla"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={url('/demo-poster.jpg')}
				aria-label="Demo de Pesadilla, un juego hecho con Cometa y Pincel"
			>
				<source src={url('/demo.webm')} type="video/webm" />
				<source src={url('/demo.min.mp4')} type="video/mp4" />
			</video>
				<figcaption>
					Pesadilla, una demo hecha con Cometa y Pincel.
					<a href={PESADILLA}>Ver el código en GitHub <span aria-hidden="true">→</span></a>
				</figcaption>
			</figure>
			<CodeWindow codigo={juego} archivo="mi_juego.cometa" />
		</div>
	</div>
</section>

<style>
	.juegos {
		background:
			radial-gradient(600px 400px at 90% 30%, rgb(166 221 234 / 0.08), transparent 70%),
			linear-gradient(180deg, transparent, rgb(104 112 184 / 0.06), transparent);
	}
	.rejilla {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.texto {
		color: var(--tinta-suave);
		font-size: 1.1rem;
	}
	.modulos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
	}
	.modulos li {
		font-family: var(--fuente-codigo);
		font-size: 0.8rem;
		padding: 0.35rem 0.7rem;
		border-radius: 8px;
		border: 1px solid var(--linea);
		background: var(--noche-2);
		color: var(--pervinca);
	}
	.demo {
		position: relative;
		min-width: 0;
		display: grid;
		gap: 1rem;
	}
	.video {
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
	figcaption {
		font-size: 0.9rem;
		color: var(--tinta-suave);
	}
	figcaption a {
		margin-left: 0.4rem;
		color: var(--celeste);
		font-weight: 600;
	}
	.pantalla {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radio);
		border: 4px solid var(--noche-3);
		background: #080913;
		box-shadow: 0 0 0 1px var(--linea), 0 20px 60px -20px rgb(166 221 234 / 0.25);
	}
	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
	}
</style>
